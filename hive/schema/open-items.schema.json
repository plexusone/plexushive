{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plexusone/plexushive/hive/schema/open-items.schema.json",
  "$ref": "#/$defs/OpenItems",
  "$defs": {
    "DecisionRequest": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string"
        },
        "situation": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "type": "array"
        },
        "recommendation": {
          "type": "string"
        },
        "approval": {
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string",
            "pattern": "^(INIT|RMI)-[A-Z0-9]+-[0-9]{3}$"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string",
            "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "type": "array"
        },
        "asked": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "situation",
        "options",
        "recommendation",
        "approval"
      ]
    },
    "ItemSource": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "report",
            "adr",
            "document"
          ]
        },
        "repository": {
          "type": "string",
          "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "path": {
          "type": "string"
        },
        "document": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "OpenItem": {
      "properties": {
        "key": {
          "type": "string"
        },
        "identity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source": {
          "$ref": "#/$defs/ItemSource"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "open",
            "deferred",
            "decided",
            "withdrawn"
          ]
        },
        "request": {
          "$ref": "#/$defs/DecisionRequest"
        },
        "decision": {
          "type": "string"
        },
        "related": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key",
        "identity",
        "source",
        "status",
        "request"
      ]
    },
    "OpenItems": {
      "properties": {
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/OpenItem"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "items"
      ]
    },
    "Option": {
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "costAndRisk": {
          "type": "string"
        },
        "irreversible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "description",
        "costAndRisk"
      ]
    }
  },
  "title": "Open items",
  "description": "Every question waiting on the operator, from work identities' reports and from design records, with its status until it is decided or withdrawn."
}
