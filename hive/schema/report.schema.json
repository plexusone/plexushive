{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plexusone/plexushive/hive/schema/report.schema.json",
  "$ref": "#/$defs/Report",
  "$defs": {
    "Blocker": {
      "properties": {
        "description": {
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "waitingOn": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "description",
        "waitingOn"
      ]
    },
    "DecisionRequest": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string"
        },
        "situation": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "type": "array"
        },
        "recommendation": {
          "type": "string"
        },
        "approval": {
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "situation",
        "options",
        "recommendation",
        "approval"
      ]
    },
    "Item": {
      "properties": {
        "description": {
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "description"
      ]
    },
    "Option": {
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "costAndRisk": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "description",
        "costAndRisk"
      ]
    },
    "Report": {
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "generated": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        },
        "done": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "blocked": {
          "items": {
            "$ref": "#/$defs/Blocker"
          },
          "type": "array"
        },
        "next": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "decisionsNeeded": {
          "items": {
            "$ref": "#/$defs/DecisionRequest"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "role",
        "generated"
      ]
    }
  },
  "title": "Status report",
  "description": "One role's status: what it finished, what is blocked and on whom, what it does next, and the decisions it needs from the operator."
}
