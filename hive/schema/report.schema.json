{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plexusone/plexushive/hive/schema/report.schema.json",
  "$ref": "#/$defs/Report",
  "$defs": {
    "Action": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "push",
            "merge",
            "tag",
            "deploy",
            "create-repository",
            "configure",
            "test",
            "review",
            "other"
          ]
        },
        "description": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "after": {
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "type": "array"
        },
        "decision": {
          "type": "string"
        },
        "option": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string"
        },
        "commits": {
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "type": "array"
        },
        "pullRequests": {
          "items": {
            "type": "string",
            "pattern": "^(https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+|#[0-9]+)$"
          },
          "type": "array"
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "credentials": {
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
          },
          "type": "array"
        },
        "checks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "irreversible": {
          "type": "boolean"
        },
        "ongoing": {
          "type": "boolean"
        },
        "followUp": {
          "type": "string"
        },
        "unblocks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "refs": {
          "items": {
            "type": "string",
            "pattern": "^(INIT|RMI)-[A-Z0-9]+-[0-9]{3}$"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "description"
      ]
    },
    "Blocker": {
      "properties": {
        "description": {
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string",
            "pattern": "^(INIT|RMI)-[A-Z0-9]+-[0-9]{3}$"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string",
            "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "type": "array"
        },
        "branch": {
          "type": "string"
        },
        "commits": {
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "type": "array"
        },
        "pullRequests": {
          "items": {
            "type": "string",
            "pattern": "^(https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+|#[0-9]+)$"
          },
          "type": "array"
        },
        "state": {
          "type": "string",
          "enum": [
            "uncommitted",
            "committed",
            "pushed",
            "released",
            "deployed"
          ]
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "waitingOn": {
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": "array",
          "minItems": 1
        },
        "decision": {
          "type": "string"
        },
        "credentials": {
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
          },
          "type": "array"
        },
        "unblocks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "description",
        "waitingOn"
      ]
    },
    "DecisionRequest": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string"
        },
        "situation": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "type": "array"
        },
        "recommendation": {
          "type": "string"
        },
        "approval": {
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string",
            "pattern": "^(INIT|RMI)-[A-Z0-9]+-[0-9]{3}$"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string",
            "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "type": "array"
        },
        "asked": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "situation",
        "options",
        "recommendation",
        "approval"
      ]
    },
    "Item": {
      "properties": {
        "description": {
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string",
            "pattern": "^(INIT|RMI)-[A-Z0-9]+-[0-9]{3}$"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string",
            "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "type": "array"
        },
        "branch": {
          "type": "string"
        },
        "commits": {
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "type": "array"
        },
        "pullRequests": {
          "items": {
            "type": "string",
            "pattern": "^(https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+|#[0-9]+)$"
          },
          "type": "array"
        },
        "state": {
          "type": "string",
          "enum": [
            "uncommitted",
            "committed",
            "pushed",
            "released",
            "deployed"
          ]
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "description"
      ]
    },
    "Notice": {
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "repositories": {
          "items": {
            "type": "string",
            "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "type": "array"
        },
        "modules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "refs": {
          "items": {
            "type": "string",
            "pattern": "^(INIT|RMI)-[A-Z0-9]+-[0-9]{3}$"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title",
        "description"
      ]
    },
    "Option": {
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "costAndRisk": {
          "type": "string"
        },
        "irreversible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "description",
        "costAndRisk"
      ]
    },
    "Report": {
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "generated": {
          "type": "string",
          "format": "date-time"
        },
        "session": {
          "$ref": "#/$defs/Session"
        },
        "summary": {
          "type": "string"
        },
        "idle": {
          "type": "boolean"
        },
        "operatorActions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "type": "array"
        },
        "inProgress": {
          "items": {
            "$ref": "#/$defs/Work"
          },
          "type": "array"
        },
        "done": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "blocked": {
          "items": {
            "$ref": "#/$defs/Blocker"
          },
          "type": "array"
        },
        "next": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "decisionsNeeded": {
          "items": {
            "$ref": "#/$defs/DecisionRequest"
          },
          "type": "array"
        },
        "notices": {
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "identity",
        "generated"
      ]
    },
    "Session": {
      "properties": {
        "tmux": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Work": {
      "properties": {
        "description": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "uncommitted",
            "committed",
            "pushed"
          ]
        },
        "credentials": {
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
          },
          "type": "array"
        },
        "refs": {
          "items": {
            "type": "string",
            "pattern": "^(INIT|RMI)-[A-Z0-9]+-[0-9]{3}$"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "description",
        "repository"
      ]
    }
  },
  "title": "Status report",
  "description": "One work identity's current status: the operator's actions it waits on, its work in progress, what it finished, what is blocked and on whom, what it does next, the decisions it needs and notices for other work identities. Reports are kept outside version control, so they can describe unpublished work plainly."
}
