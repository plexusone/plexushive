{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plexusone/plexushive/hive/schema/decision.schema.json",
  "$ref": "#/$defs/Decision",
  "$defs": {
    "Alternative": {
      "properties": {
        "option": {
          "type": "string"
        },
        "rejected": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "option",
        "rejected"
      ]
    },
    "Decision": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "superseded"
          ]
        },
        "decision": {
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "type": "array"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repositories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "supersedes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "supersededBy": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "decision",
        "reasons"
      ]
    }
  },
  "title": "Decision",
  "description": "One entry in the append-only decision log: what was decided, why, the alternatives, and what it binds."
}
